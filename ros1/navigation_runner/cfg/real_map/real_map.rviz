Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 50
      Reference Frame: map
      Value: true
    - Class: rviz/TF
      Enabled: false
      Name: TF
      Value: false
    - Alpha: 0.8
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 170; 170; 170
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Real Map
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.03
      Style: Points
      Topic: /real_map/cloud
      Unreliable: false
      Use Fixed Frame: true
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 170; 0; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Policy LiDAR
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: true
      Size (Pixels): 5
      Size (m): 0.03
      Style: Points
      Topic: /tunnel_nav/lidar_cloud
      Unreliable: false
      Use Fixed Frame: true
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /tunnel_nav/cmd_vel_vis
      Name: RL Command
      Queue Size: 1
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /tunnel_nav/human_cmd_vis
      Name: Human Command
      Queue Size: 1
      Value: true
    - Angle Tolerance: 0.01
      Class: rviz/Odometry
      Enabled: true
      Keep: 200
      Name: Drone Odom
      Position Tolerance: 0.01
      Queue Size: 10
      Shape:
        Value: Arrow
      Topic: /CERLAB/quadcopter/odom
      Unreliable: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 30
      Focal Point:
        X: 0
        Y: 0
        Z: 2
      Name: Current View
      Pitch: 0.6
      Target Frame: map
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
