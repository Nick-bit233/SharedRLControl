<launch>
    <!-- ============================================================ -->
    <!-- Tunnel Comparison: unified launcher for RL vs IPC            -->
    <!-- Usage: roslaunch navigation_runner tunnel_comparison.launch   -->
    <!--        method:=rl   (or method:=ipc)  gui:=true             -->
    <!-- ============================================================ -->

    <arg name="method" default="rl" doc="rl or ipc"/>
    <arg name="gui" default="false" doc="Show Gazebo GUI (requires X11 display)"/>
    <arg name="keyboard" default="false" doc="Keyboard teleop mode (RL only)"/>
    <arg name="tunnel_map"
         default="$(find navigation_runner)/cfg/tunnel/tunnel_map_default.pcd"/>
    <arg name="checkpoint"
         default="$(find navigation_runner)/cfg/tunnel/checkpoint_best.pt"/>
    <arg name="trial_id" default="0"/>
    <arg name="record" default="true"/>
    <arg name="rviz" default="true"/>
    <arg name="device" default="cpu"/>
    <arg name="user_model_simple" default="false"/>
    <arg name="user_model_speed" default="2.0"/>
    <arg name="user_model_freq_base" default="0.1"/>
    <arg name="user_model_freq_scale" default="0.3"/>
    <arg name="user_model_seed" default="42"/>
    <arg name="user_model_rate" default="20.0"/>
    <arg name="output_dir" default="/root/results"/>

    <!-- Spawn position: in the clear zone (X∈[-12,-6]).
         Current default is intentionally shifted from the IsaacSim x=-7
         baseline to avoid takeoff collision on the current Gazebo PCD/world
         asset pair. -->
    <arg name="spawn_x" default="-8.5"/>
    <arg name="spawn_y" default="0.0"/>
    <arg name="spawn_z" default="0.1"/>
    
    <!-- ===== Shared: Gazebo CERLAB Simulator ===== -->
    <!-- Uses the auto-generated world that matches the PCD obstacle map.
         In keyboard mode we launch our own keyboard_control with topic remap,
         so we pass gui:=false to suppress the default one from start_headless,
         then optionally start gzclient ourselves. -->
    <include file="$(find uav_simulator)/launch/start_headless.launch">
        <arg name="gui" value="$(eval not arg('keyboard') and arg('gui'))"/>
        <arg name="world_name"
             value="$(find uav_simulator)/worlds/generated_env/tunnel_pcd_match_static.world"/>
        <arg name="spawn_x" value="$(arg spawn_x)"/>
        <arg name="spawn_y" value="$(arg spawn_y)"/>
        <arg name="spawn_z" value="$(arg spawn_z)"/>
    </include>

    <!-- In keyboard mode with gui: start gzclient separately (start_headless
         was given gui=false to avoid launching its keyboard_control) -->
    <group if="$(eval arg('keyboard') and arg('gui'))">
        <node name="gazebo_gui" pkg="gazebo_ros" type="gzclient"
              respawn="false" output="screen"/>
    </group>

    <!-- In keyboard mode: launch CERLAB keyboard_control with cmd_vel
         remapped to /keyboard/cmd_vel so tunnel_navigation can intercept it.
         Takeoff/land/hover still go directly to the Gazebo plugin. -->
    <node if="$(arg keyboard)"
          name="keyboard_control" pkg="uav_simulator" type="keyboard_control">
        <remap from="/CERLAB/quadcopter/cmd_vel" to="/keyboard/cmd_vel"/>
    </node>

    <!-- ===== RL Mode ===== -->
    <group if="$(eval method == 'rl')">
        <!-- LiDAR Simulator: PCD -> PointCloud2 (same as IPC mode) -->
        <node pkg="navigation_runner" type="lidar_sim_node.py"
              name="lidar_sim" output="screen">
            <param name="pcd_file" value="$(arg tunnel_map)"/>
            <param name="rate" value="10"/>
            <param name="max_range" value="50.0"/>
            <param name="noise_stddev" value="0.02"/>
        </node>

        <!-- Map Manager for RL LiDAR (occupancy map with RayCast service) -->
        <rosparam file="$(find navigation_runner)/cfg/tunnel/occupancy_map_tunnel.yaml"
                  ns="/occupancy_map" />
        <param name="/occupancy_map/prebuilt_map_directory" value="$(arg tunnel_map)"/>
        <node pkg="map_manager" type="occupancy_map_node" name="occupancy_map_node"
              output="screen"/>

        <!-- RL Navigation Node -->
        <node pkg="navigation_runner" type="tunnel_navigation.py"
              name="tunnel_navigator" output="screen">
            <rosparam file="$(find navigation_runner)/cfg/tunnel/tunnel_nav_param.yaml"/>
            <param name="checkpoint_path" value="$(arg checkpoint)"/>
            <param name="device" value="$(arg device)"/>
            <param name="keyboard_mode" value="$(arg keyboard)"/>
            <param name="pcd_file" value="$(arg tunnel_map)"/>
            <param name="user_model_simple" value="$(arg user_model_simple)"/>
            <param name="user_model_speed" value="$(arg user_model_speed)"/>
            <param name="user_model_freq_base" value="$(arg user_model_freq_base)"/>
            <param name="user_model_freq_scale" value="$(arg user_model_freq_scale)"/>
            <param name="user_model_seed" value="$(arg user_model_seed)"/>
        </node>
    </group>

    <!-- ===== IPC Mode ===== -->
    <group if="$(eval method == 'ipc')">
        <include file="$(find navigation_runner)/launch/tunnel_ipc_sim.launch">
            <arg name="start_gazebo" value="false"/>
            <arg name="tunnel_map" value="$(arg tunnel_map)"/>
            <arg name="trial_id" value="$(arg trial_id)"/>
            <arg name="record" value="false"/>
            <arg name="rviz" value="false"/>
            <arg name="device" value="$(arg device)"/>
            <arg name="user_model_simple" value="$(arg user_model_simple)"/>
            <arg name="user_model_speed" value="$(arg user_model_speed)"/>
            <arg name="user_model_freq_base" value="$(arg user_model_freq_base)"/>
            <arg name="user_model_freq_scale" value="$(arg user_model_freq_scale)"/>
            <arg name="user_model_seed" value="$(arg user_model_seed)"/>
            <arg name="user_model_rate" value="$(arg user_model_rate)"/>
        </include>
    </group>

    <!-- ===== Shared: Flight Recorder ===== -->
    <group if="$(arg record)">
        <node pkg="navigation_runner" type="flight_recorder.py"
              name="flight_recorder" output="screen">
            <param name="method" value="$(arg method)"/>
            <param name="trial_id" value="$(arg trial_id)"/>
            <param name="output_dir" value="$(arg output_dir)"/>
            <param name="rate" value="50"/>
            <param name="goal_x" value="12.0"/>
        </node>
    </group>

    <!-- ===== Shared: RViz ===== -->
    <group if="$(eval arg('rviz') and arg('method') == 'rl')">
        <node pkg="rviz" type="rviz" name="rviz"
              args="-d $(find navigation_runner)/cfg/tunnel/tunnel.rviz"/>
    </group>
    <group if="$(eval arg('rviz') and arg('method') == 'ipc')">
        <node pkg="rviz" type="rviz" name="rviz"
              args="-d $(find navigation_runner)/cfg/tunnel/ipc_tunnel.rviz"/>
    </group>
</launch>
