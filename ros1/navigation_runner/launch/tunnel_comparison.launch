<launch>
    <!-- ============================================================ -->
    <!-- Tunnel Comparison: unified launcher for RL vs IPC            -->
    <!-- Usage: roslaunch navigation_runner tunnel_comparison.launch   -->
    <!--        method:=rl   (or method:=ipc)                        -->
    <!-- ============================================================ -->

    <arg name="method" default="rl" doc="rl or ipc"/>
    <arg name="gui" default="false" doc="Show Gazebo GUI (requires X11 display)"/>
    <arg name="tunnel_map"
         default="$(find navigation_runner)/cfg/tunnel/tunnel_map_default.pcd"/>
    <arg name="checkpoint"
         default="$(find navigation_runner)/checkpoints/curriculum_stage5/2026-03-24_14-02-37/wandb/run-20260324_140244-w85uemxv/files/checkpoint_best.pt"/>
    <arg name="trial_id" default="0"/>
    <arg name="record" default="true"/>
    <arg name="rviz" default="true"/>
    <arg name="device" default="cpu"/>
    <arg name="output_dir" default="/tmp/flight_data"/>

    <!-- ===== Shared: Gazebo CERLAB Simulator ===== -->
    <include file="$(find uav_simulator)/launch/start_headless.launch">
        <arg name="gui" value="$(arg gui)"/>
    </include>

    <!-- ===== RL Mode ===== -->
    <group if="$(eval method == 'rl')">
        <!-- Map Manager for RL LiDAR (occupancy map with RayCast service) -->
        <rosparam file="$(find navigation_runner)/cfg/tunnel/occupancy_map_tunnel.yaml"
                  ns="/occupancy_map" />
        <param name="/occupancy_map/prebuilt_map_directory" value="$(arg tunnel_map)"/>
        <node pkg="map_manager" type="occupancy_map_node" name="occupancy_map_node"
              output="screen"/>

        <!-- RL Navigation Node -->
        <node pkg="navigation_runner" type="tunnel_navigation.py"
              name="tunnel_navigator" output="screen">
            <rosparam file="$(find navigation_runner)/cfg/tunnel/tunnel_nav_param.yaml"/>
            <param name="checkpoint_path" value="$(arg checkpoint)"/>
            <param name="device" value="$(arg device)"/>
            <param name="use_px4" value="false"/>
            <param name="user_model_simple" value="true"/>
        </node>
    </group>

    <!-- ===== IPC Mode ===== -->
    <group if="$(eval method == 'ipc')">
        <include file="$(find navigation_runner)/launch/tunnel_ipc_sim.launch">
            <arg name="start_gazebo" value="false"/>
            <arg name="tunnel_map" value="$(arg tunnel_map)"/>
            <arg name="trial_id" value="$(arg trial_id)"/>
            <arg name="record" value="false"/>
            <arg name="rviz" value="false"/>
        </include>
    </group>

    <!-- ===== Shared: Flight Recorder ===== -->
    <group if="$(arg record)">
        <node pkg="navigation_runner" type="flight_recorder.py"
              name="flight_recorder" output="screen">
            <param name="method" value="$(arg method)"/>
            <param name="trial_id" value="$(arg trial_id)"/>
            <param name="output_dir" value="$(arg output_dir)"/>
            <param name="rate" value="50"/>
            <param name="goal_x" value="15.0"/>
        </node>
    </group>

    <!-- ===== Shared: RViz ===== -->
    <group if="$(arg rviz)">
        <node pkg="rviz" type="rviz" name="rviz"
              args="-d $(find navigation_runner)/cfg/tunnel/tunnel.rviz"/>
    </group>
</launch>
