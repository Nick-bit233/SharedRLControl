<launch>
    <!-- ============================================================ -->
    <!-- Tunnel Comparison: unified launcher for RL vs IPC            -->
    <!-- Usage: roslaunch navigation_runner tunnel_comparison.launch   -->
    <!--        method:=rl   (or method:=ipc)  gui:=true             -->
    <!-- ============================================================ -->

    <arg name="method" default="rl" doc="rl or ipc"/>
    <arg name="gui" default="false" doc="Show Gazebo GUI (requires X11 display)"/>
    <arg name="keyboard" default="false" doc="Keyboard teleop mode (RL only)"/>
    <arg name="tunnel_map"
         default="$(find navigation_runner)/cfg/tunnel/tunnel_map_default.pcd"/>
    <arg name="tunnel_world"
         default="$(find uav_simulator)/worlds/generated_env/tunnel_pcd_match_static.world"/>
    <arg name="checkpoint"
         default="$(find navigation_runner)/cfg/ckpts/checkpoint_tunnel_M3_21500.pt"/>
    <arg name="trial_id" default="0"/>
    <arg name="record" default="true"/>
    <arg name="rviz" default="true"/>
    <arg name="device" default="cpu"/>
    <arg name="ipc_launch_prefix" default=""/>
    <arg name="ipc_spinner_threads" default="2"/>
    <arg name="user_model_simple" default="false"/>
    <arg name="user_model_profile" default="m3_diverse"/>
    <arg name="user_model_speed" default="2.0"/>
    <arg name="user_model_freq_base" default="0.1"/>
    <arg name="user_model_freq_scale" default="0.2"/>
    <arg name="user_model_vx_bias" default="1.5"/>
    <arg name="user_model_vx_amp" default="0.5"/>
    <arg name="user_model_vy_amp" default="2.0"/>
    <arg name="user_model_vz_amp" default="0.2"/>
    <arg name="user_model_smoothness_base" default="0.4"/>
    <arg name="user_model_smoothness_scale" default="0.5"/>
    <arg name="user_model_laziness" default="0.3"/>
    <arg name="user_model_seed" default="42"/>
    <arg name="user_model_rate" default="20.0"/>
    <arg name="input_source" default="online" doc="online or offline"/>
    <arg name="replay_dataset_path" default=""/>
    <arg name="replay_dataset_format" default="hdf5"/>
    <arg name="replay_sampling_mode" default="raw"/>
    <arg name="replay_trajectory_index" default="-1"/>
    <arg name="replay_start_offset" default="-1"/>
    <arg name="replay_loop" default="true"/>
    <arg name="output_dir" default="/root/results"/>
    <arg name="goal_x" default="12.0"/>
    <arg name="collision_dist" default="0.05"/>
    <arg name="safety_min_dist" default="0.2"/>
    <arg name="safety_mode" default="hold"/>
    <arg name="safety_recover_speed" default="0.35"/>
    <arg name="safety_recover_forward_speed" default="0.15"/>
    <arg name="safety_recover_centerline_gain" default="0.4"/>
    <arg name="gazebo_z_mode" default="alt_hold"/>
    <arg name="gazebo_policy_z_max" default="2.0"/>
    <arg name="gazebo_z_blend_alpha" default="0.5"/>
    <arg name="gazebo_policy_z_takeoff_gate" default="true"/>
    <arg name="gazebo_policy_z_gate_tolerance" default="0.5"/>
    <arg name="policy_takeoff_gate" default="true"/>
    <arg name="policy_takeoff_gate_tolerance" default="0.5"/>
    <arg name="auto_terminate" default="true"/>
    <arg name="shutdown_on_complete" default="true"/>
    <arg name="timeout_sec" default="0.0"/>
    <arg name="completion_grace_period" default="0.5"/>
    <arg name="batch_idx" default="-1"/>
    <arg name="run_idx" default="-1"/>
    <arg name="run_id" default=""/>
    <arg name="map_seed" default="-1"/>

    <!-- Spawn position: in the clear zone (X∈[-12,-6]).
         Current default is intentionally shifted from the IsaacSim x=-7
         baseline to avoid takeoff collision on the current Gazebo PCD/world
         asset pair. -->
    <arg name="spawn_x" default="-8.5"/>
    <arg name="spawn_y" default="0.0"/>
    <arg name="spawn_z" default="0.1"/>
    
    <!-- ===== Shared: Gazebo CERLAB Simulator ===== -->
    <!-- Uses the auto-generated world that matches the PCD obstacle map.
         In keyboard mode we launch our own keyboard_control with topic remap,
         so we pass gui:=false to suppress the default one from start_headless,
         then optionally start gzclient ourselves. -->
    <include file="$(find uav_simulator)/launch/start_headless.launch">
        <arg name="gui" value="$(eval not arg('keyboard') and arg('gui'))"/>
        <arg name="world_name" value="$(arg tunnel_world)"/>
        <arg name="spawn_x" value="$(arg spawn_x)"/>
        <arg name="spawn_y" value="$(arg spawn_y)"/>
        <arg name="spawn_z" value="$(arg spawn_z)"/>
    </include>

    <!-- In keyboard mode with gui: start gzclient separately (start_headless
         was given gui=false to avoid launching its keyboard_control) -->
    <group if="$(eval arg('keyboard') and arg('gui'))">
        <node name="gazebo_gui" pkg="gazebo_ros" type="gzclient"
              respawn="false" output="screen"/>
    </group>

    <!-- In keyboard mode: launch CERLAB keyboard_control with cmd_vel
         remapped to /keyboard/cmd_vel so tunnel_navigation can intercept it.
         Takeoff/land/hover still go directly to the Gazebo plugin. -->
    <node if="$(arg keyboard)"
          name="keyboard_control" pkg="uav_simulator" type="keyboard_control">
        <remap from="/CERLAB/quadcopter/cmd_vel" to="/keyboard/cmd_vel"/>
    </node>

    <!-- ===== RL Mode ===== -->
    <group if="$(eval method == 'rl')">
        <!-- LiDAR Simulator: PCD -> PointCloud2 (same as IPC mode) -->
        <node pkg="navigation_runner" type="lidar_sim_node.py"
              name="lidar_sim" output="screen">
            <param name="pcd_file" value="$(arg tunnel_map)"/>
            <param name="rate" value="10"/>
            <param name="max_range" value="50.0"/>
            <param name="noise_stddev" value="0.02"/>
        </node>

        <!-- Map Manager for RL LiDAR (occupancy map with RayCast service) -->
        <rosparam file="$(find navigation_runner)/cfg/tunnel/occupancy_map_tunnel.yaml"
                  ns="/occupancy_map" />
        <param name="/occupancy_map/prebuilt_map_directory" value="$(arg tunnel_map)"/>
        <node pkg="map_manager" type="occupancy_map_node" name="occupancy_map_node"
              output="screen"/>

        <!-- RL Navigation Node -->
        <node pkg="navigation_runner" type="tunnel_navigation.py"
              name="tunnel_navigator" output="screen">
            <rosparam file="$(find navigation_runner)/cfg/tunnel/tunnel_nav_param.yaml"/>
            <param name="checkpoint_path" value="$(arg checkpoint)"/>
            <param name="device" value="$(arg device)"/>
            <param name="keyboard_mode" value="$(arg keyboard)"/>
            <param name="pcd_file" value="$(arg tunnel_map)"/>
            <param name="user_model_simple" value="$(arg user_model_simple)"/>
            <param name="user_model_profile" value="$(arg user_model_profile)"/>
            <param name="user_model_speed" value="$(arg user_model_speed)"/>
            <param name="user_model_freq_base" value="$(arg user_model_freq_base)"/>
            <param name="user_model_freq_scale" value="$(arg user_model_freq_scale)"/>
            <param name="user_model_vx_bias" value="$(arg user_model_vx_bias)"/>
            <param name="user_model_vx_amp" value="$(arg user_model_vx_amp)"/>
            <param name="user_model_vy_amp" value="$(arg user_model_vy_amp)"/>
            <param name="user_model_vz_amp" value="$(arg user_model_vz_amp)"/>
            <param name="user_model_smoothness_base" value="$(arg user_model_smoothness_base)"/>
            <param name="user_model_smoothness_scale" value="$(arg user_model_smoothness_scale)"/>
            <param name="user_model_laziness" value="$(arg user_model_laziness)"/>
            <param name="user_model_seed" value="$(arg user_model_seed)"/>
            <param name="input_source" value="$(arg input_source)"/>
            <param name="replay_dataset_path" value="$(arg replay_dataset_path)"/>
            <param name="replay_dataset_format" value="$(arg replay_dataset_format)"/>
            <param name="replay_sampling_mode" value="$(arg replay_sampling_mode)"/>
            <param name="replay_trajectory_index" value="$(arg replay_trajectory_index)"/>
            <param name="replay_start_offset" value="$(arg replay_start_offset)"/>
            <param name="replay_loop" value="$(arg replay_loop)"/>
            <param name="goal_x" value="$(arg goal_x)"/>
            <param name="collision_dist" value="$(arg collision_dist)"/>
            <param name="safety_min_dist" value="$(arg safety_min_dist)"/>
            <param name="safety_mode" value="$(arg safety_mode)"/>
            <param name="safety_recover_speed" value="$(arg safety_recover_speed)"/>
            <param name="safety_recover_forward_speed" value="$(arg safety_recover_forward_speed)"/>
            <param name="safety_recover_centerline_gain" value="$(arg safety_recover_centerline_gain)"/>
            <param name="gazebo_z_mode" value="$(arg gazebo_z_mode)"/>
            <param name="gazebo_policy_z_max" value="$(arg gazebo_policy_z_max)"/>
            <param name="gazebo_z_blend_alpha" value="$(arg gazebo_z_blend_alpha)"/>
            <param name="gazebo_policy_z_takeoff_gate" value="$(arg gazebo_policy_z_takeoff_gate)"/>
            <param name="gazebo_policy_z_gate_tolerance" value="$(arg gazebo_policy_z_gate_tolerance)"/>
            <param name="policy_takeoff_gate" value="$(arg policy_takeoff_gate)"/>
            <param name="policy_takeoff_gate_tolerance" value="$(arg policy_takeoff_gate_tolerance)"/>
        </node>
    </group>

    <!-- ===== IPC Mode ===== -->
    <group if="$(eval method == 'ipc')">
        <include file="$(find navigation_runner)/launch/tunnel_ipc_sim.launch">
            <arg name="start_gazebo" value="false"/>
            <arg name="tunnel_map" value="$(arg tunnel_map)"/>
            <arg name="tunnel_world" value="$(arg tunnel_world)"/>
            <arg name="trial_id" value="$(arg trial_id)"/>
            <arg name="record" value="false"/>
            <arg name="rviz" value="false"/>
            <arg name="device" value="$(arg device)"/>
            <arg name="ipc_launch_prefix" value="$(arg ipc_launch_prefix)"/>
            <arg name="ipc_spinner_threads" value="$(arg ipc_spinner_threads)"/>
            <arg name="user_model_simple" value="$(arg user_model_simple)"/>
            <arg name="user_model_profile" value="$(arg user_model_profile)"/>
            <arg name="user_model_speed" value="$(arg user_model_speed)"/>
            <arg name="user_model_freq_base" value="$(arg user_model_freq_base)"/>
            <arg name="user_model_freq_scale" value="$(arg user_model_freq_scale)"/>
            <arg name="user_model_vx_bias" value="$(arg user_model_vx_bias)"/>
            <arg name="user_model_vx_amp" value="$(arg user_model_vx_amp)"/>
            <arg name="user_model_vy_amp" value="$(arg user_model_vy_amp)"/>
            <arg name="user_model_vz_amp" value="$(arg user_model_vz_amp)"/>
            <arg name="user_model_smoothness_base" value="$(arg user_model_smoothness_base)"/>
            <arg name="user_model_smoothness_scale" value="$(arg user_model_smoothness_scale)"/>
            <arg name="user_model_laziness" value="$(arg user_model_laziness)"/>
            <arg name="user_model_seed" value="$(arg user_model_seed)"/>
            <arg name="user_model_rate" value="$(arg user_model_rate)"/>
            <arg name="input_source" value="$(arg input_source)"/>
            <arg name="replay_dataset_path" value="$(arg replay_dataset_path)"/>
            <arg name="replay_dataset_format" value="$(arg replay_dataset_format)"/>
            <arg name="replay_sampling_mode" value="$(arg replay_sampling_mode)"/>
            <arg name="replay_trajectory_index" value="$(arg replay_trajectory_index)"/>
            <arg name="replay_start_offset" value="$(arg replay_start_offset)"/>
            <arg name="replay_loop" value="$(arg replay_loop)"/>
        </include>
    </group>

    <!-- ===== Shared: Flight Recorder ===== -->
    <group if="$(arg record)">
        <node pkg="navigation_runner" type="flight_recorder.py"
              name="flight_recorder" output="screen"
              required="$(arg shutdown_on_complete)">
            <param name="method" value="$(arg method)"/>
            <param name="trial_id" value="$(arg trial_id)"/>
            <param name="output_dir" value="$(arg output_dir)"/>
            <param name="rate" value="50"/>
            <param name="goal_x" value="$(arg goal_x)"/>
            <param name="collision_dist" value="$(arg collision_dist)"/>
            <param name="collision_topic" value="$(eval '/tunnel_nav/collision' if arg('method') == 'rl' else '')"/>
            <param name="pcd_file" value="$(arg tunnel_map)"/>
            <param name="auto_terminate" value="$(arg auto_terminate)"/>
            <param name="shutdown_on_complete" value="$(arg shutdown_on_complete)"/>
            <param name="timeout_sec" value="$(arg timeout_sec)"/>
            <param name="completion_grace_period" value="$(arg completion_grace_period)"/>
            <param name="batch_idx" value="$(arg batch_idx)"/>
            <param name="run_idx" value="$(arg run_idx)"/>
            <param name="run_id" value="$(arg run_id)"/>
            <param name="map_seed" value="$(arg map_seed)"/>
            <param name="user_model_seed" value="$(arg user_model_seed)"/>
            <param name="user_model_profile" value="$(arg user_model_profile)"/>
            <param name="user_model_simple" value="$(arg user_model_simple)"/>
            <param name="user_model_speed" value="$(arg user_model_speed)"/>
            <param name="user_model_freq_base" value="$(arg user_model_freq_base)"/>
            <param name="user_model_freq_scale" value="$(arg user_model_freq_scale)"/>
            <param name="user_model_vx_bias" value="$(arg user_model_vx_bias)"/>
            <param name="user_model_vx_amp" value="$(arg user_model_vx_amp)"/>
            <param name="user_model_vy_amp" value="$(arg user_model_vy_amp)"/>
            <param name="user_model_vz_amp" value="$(arg user_model_vz_amp)"/>
            <param name="input_source" value="$(arg input_source)"/>
            <param name="replay_dataset_path" value="$(arg replay_dataset_path)"/>
            <param name="replay_dataset_format" value="$(arg replay_dataset_format)"/>
            <param name="replay_sampling_mode" value="$(arg replay_sampling_mode)"/>
            <param name="replay_trajectory_index" value="$(arg replay_trajectory_index)"/>
            <param name="replay_start_offset" value="$(arg replay_start_offset)"/>
            <param name="replay_loop" value="$(arg replay_loop)"/>
            <param name="gazebo_z_mode" value="$(arg gazebo_z_mode)"/>
            <param name="gazebo_policy_z_max" value="$(arg gazebo_policy_z_max)"/>
            <param name="gazebo_z_blend_alpha" value="$(arg gazebo_z_blend_alpha)"/>
            <param name="gazebo_policy_z_takeoff_gate" value="$(arg gazebo_policy_z_takeoff_gate)"/>
            <param name="gazebo_policy_z_gate_tolerance" value="$(arg gazebo_policy_z_gate_tolerance)"/>
            <param name="policy_takeoff_gate" value="$(arg policy_takeoff_gate)"/>
            <param name="policy_takeoff_gate_tolerance" value="$(arg policy_takeoff_gate_tolerance)"/>
            <param name="tunnel_world" value="$(arg tunnel_world)"/>
        </node>
    </group>

    <!-- ===== Shared: RViz ===== -->
    <group if="$(eval arg('rviz') and arg('method') == 'rl')">
        <node pkg="rviz" type="rviz" name="rviz"
              args="-d $(find navigation_runner)/cfg/tunnel/tunnel.rviz"/>
    </group>
    <group if="$(eval arg('rviz') and arg('method') == 'ipc')">
        <node pkg="rviz" type="rviz" name="rviz"
              args="-d $(find navigation_runner)/cfg/tunnel/ipc_tunnel.rviz"/>
    </group>
</launch>
