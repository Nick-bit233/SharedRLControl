<launch>
    <!-- ============================================================ -->
    <!--  Tunnel RL Policy Deployment — Full Simulation Stack          -->
    <!--  Usage:                                                       -->
    <!--    roslaunch navigation_runner tunnel_sim.launch               -->
    <!--        checkpoint:=/path/to/checkpoint_tunnel_M3_21500.pt     -->
    <!--        tunnel_map:=/path/to/tunnel_map.pcd                    -->
    <!-- ============================================================ -->

    <!-- Arguments -->
    <arg name="checkpoint"      default="$(find navigation_runner)/cfg/ckpts/checkpoint_tunnel_M3_21500.pt" doc="Path to RL policy checkpoint (.pt)" />
    <arg name="tunnel_map"      default="$(find navigation_runner)/cfg/tunnel/tunnel_map_default.pcd" doc="Path to prebuilt tunnel PCD map" />
    <arg name="use_px4"         default="false" />
    <arg name="use_safety_shield" default="false" />
    <arg name="device"          default="cpu" doc="cpu or cuda:0" />
    <arg name="rviz"            default="true" />
    <arg name="user_model_simple" default="false" doc="true=constant forward, false=Perlin noise" />
    <arg name="user_model_profile" default="m3_diverse" doc="m3_diverse, legacy_perlin, or simple" />
    <arg name="user_model_speed" default="2.0" />
    <arg name="user_model_freq_base" default="0.1" />
    <arg name="user_model_freq_scale" default="0.2" />
    <arg name="user_model_vx_bias" default="1.5" />
    <arg name="user_model_vx_amp" default="0.5" />
    <arg name="user_model_vy_amp" default="2.0" />
    <arg name="user_model_vz_amp" default="0.2" />
    <arg name="user_model_smoothness_base" default="0.4" />
    <arg name="user_model_smoothness_scale" default="0.5" />
    <arg name="user_model_laziness" default="0.3" />
    <arg name="user_model_seed" default="42" />
    <arg name="spawn_x"        default="-8.5" />
    <arg name="spawn_y"        default="0.0" />
    <arg name="spawn_z"        default="0.1" />
    <arg name="gazebo_z_mode"  default="alt_hold" />
    <arg name="gazebo_policy_z_max" default="2.0" />
    <arg name="gazebo_z_blend_alpha" default="0.5" />
    <arg name="gazebo_policy_z_takeoff_gate" default="true" />
    <arg name="gazebo_policy_z_gate_tolerance" default="0.5" />
    <arg name="policy_takeoff_gate" default="true" />
    <arg name="policy_takeoff_gate_tolerance" default="0.5" />
    <arg name="start_gazebo"   default="true" />
    <arg name="gui"            default="false" doc="Gazebo GUI (disable for Docker/headless)" />

    <!-- Global param -->
    <param name="rl/use_px4" value="$(arg use_px4)" />

    <!-- ============================================================ -->
    <!--  1. Gazebo Simulator + Quadrotor                              -->
    <!-- ============================================================ -->
    <group if="$(arg start_gazebo)">
        <include file="$(find uav_simulator)/launch/start_headless.launch" unless="$(arg use_px4)">
            <arg name="gui"     value="$(arg gui)"/>
            <arg name="spawn_x" value="$(arg spawn_x)"/>
            <arg name="spawn_y" value="$(arg spawn_y)"/>
            <arg name="spawn_z" value="$(arg spawn_z)"/>
        </include>
    </group>

    <!-- Override spawn position (re-spawn model at desired location) -->
    <!-- NOTE: uav_simulator/launch/start.launch already spawns at -15,0,0.1 -->
    <!-- Modify the start.launch or use arg if different position is needed -->

    <!-- ============================================================ -->
    <!--  2. Occupancy Map (for RayCast LiDAR simulation)              -->
    <!-- ============================================================ -->
    <rosparam file="$(find navigation_runner)/cfg/tunnel/occupancy_map_tunnel.yaml" 
              ns="/occupancy_map" />
    <!-- Override map path from argument -->
    <param name="/occupancy_map/prebuilt_map_directory" value="$(arg tunnel_map)" 
           if="$(eval tunnel_map != '')" />
    <node pkg="map_manager" type="occupancy_map_node" name="occupancy_map_node" 
          output="screen" />

    <!-- ============================================================ -->
    <!--  3. Safety Shield (optional)                                  -->
    <!-- ============================================================ -->
    <group if="$(arg use_safety_shield)">
        <include file="$(find navigation_runner)/launch/safety_shield.launch" />
    </group>

    <!-- ============================================================ -->
    <!--  4. Tunnel Navigation Node (RL Policy)                        -->
    <!-- ============================================================ -->
    <node pkg="navigation_runner" type="tunnel_navigation.py" 
          name="tunnel_navigator" output="screen">
        <rosparam file="$(find navigation_runner)/cfg/tunnel/tunnel_nav_param.yaml" />
        <!-- Override critical params from launch args -->
        <param name="checkpoint_path"     value="$(arg checkpoint)" />
        <param name="pcd_file"            value="$(arg tunnel_map)" />
        <param name="device"              value="$(arg device)" />
        <param name="use_px4"             value="$(arg use_px4)" />
        <param name="use_safety_shield"   value="$(arg use_safety_shield)" />
        <param name="user_model_simple"   value="$(arg user_model_simple)" />
        <param name="user_model_profile"  value="$(arg user_model_profile)" />
        <param name="user_model_speed"    value="$(arg user_model_speed)" />
        <param name="user_model_freq_base" value="$(arg user_model_freq_base)" />
        <param name="user_model_freq_scale" value="$(arg user_model_freq_scale)" />
        <param name="user_model_vx_bias" value="$(arg user_model_vx_bias)" />
        <param name="user_model_vx_amp" value="$(arg user_model_vx_amp)" />
        <param name="user_model_vy_amp" value="$(arg user_model_vy_amp)" />
        <param name="user_model_vz_amp" value="$(arg user_model_vz_amp)" />
        <param name="user_model_smoothness_base" value="$(arg user_model_smoothness_base)" />
        <param name="user_model_smoothness_scale" value="$(arg user_model_smoothness_scale)" />
        <param name="user_model_laziness" value="$(arg user_model_laziness)" />
        <param name="user_model_seed"     value="$(arg user_model_seed)" />
        <param name="gazebo_z_mode"       value="$(arg gazebo_z_mode)" />
        <param name="gazebo_policy_z_max" value="$(arg gazebo_policy_z_max)" />
        <param name="gazebo_z_blend_alpha" value="$(arg gazebo_z_blend_alpha)" />
        <param name="gazebo_policy_z_takeoff_gate" value="$(arg gazebo_policy_z_takeoff_gate)" />
        <param name="gazebo_policy_z_gate_tolerance" value="$(arg gazebo_policy_z_gate_tolerance)" />
        <param name="policy_takeoff_gate" value="$(arg policy_takeoff_gate)" />
        <param name="policy_takeoff_gate_tolerance" value="$(arg policy_takeoff_gate_tolerance)" />
    </node>

    <!-- ============================================================ -->
    <!--  5. RViz Visualization                                        -->
    <!-- ============================================================ -->
    <group if="$(arg rviz)">
        <node pkg="rviz" type="rviz" name="tunnel_rviz"
              args="-d $(find navigation_runner)/cfg/tunnel/tunnel.rviz"
              if="$(eval optenv('DISPLAY', '') != '')" />
    </group>
</launch>
