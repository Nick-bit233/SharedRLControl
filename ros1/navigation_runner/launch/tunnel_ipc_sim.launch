<launch>
    <!-- ============================================================ -->
    <!-- IPC Tunnel Simulation: slope_inspection IPC on CERLAB Gazebo -->
    <!-- ============================================================ -->

    <arg name="start_gazebo" default="true"/>
    <arg name="tunnel_map" default="$(find navigation_runner)/cfg/tunnel/tunnel_map_default.pcd"/>
    <arg name="tunnel_world" default="$(find uav_simulator)/worlds/generated_env/tunnel_pcd_match_static.world"/>
    <arg name="trial_id" default="0"/>
    <arg name="record" default="true"/>
    <arg name="rviz" default="true"/>
    <arg name="device" default="cpu"/>
    <arg name="ipc_launch_prefix" default=""/>
    <arg name="user_model_simple" default="false"/>
    <arg name="user_model_profile" default="m3_diverse"/>
    <arg name="user_model_speed" default="2.0"/>
    <arg name="user_model_freq_base" default="0.1"/>
    <arg name="user_model_freq_scale" default="0.2"/>
    <arg name="user_model_vx_bias" default="1.5"/>
    <arg name="user_model_vx_amp" default="0.5"/>
    <arg name="user_model_vy_amp" default="2.0"/>
    <arg name="user_model_vz_amp" default="0.0"/>
    <arg name="user_model_smoothness_base" default="0.4"/>
    <arg name="user_model_smoothness_scale" default="0.5"/>
    <arg name="user_model_laziness" default="0.3"/>
    <arg name="user_model_seed" default="42"/>
    <arg name="user_model_rate" default="20.0"/>
    <arg name="output_dir" default="/root/results"/>
    <arg name="goal_x" default="12.0"/>
    <arg name="collision_dist" default="0.05"/>
    <arg name="auto_terminate" default="true"/>
    <arg name="shutdown_on_complete" default="true"/>
    <arg name="timeout_sec" default="0.0"/>
    <arg name="completion_grace_period" default="0.5"/>
    <arg name="batch_idx" default="-1"/>
    <arg name="run_idx" default="-1"/>
    <arg name="run_id" default=""/>
    <arg name="map_seed" default="-1"/>

    <!-- ===== Gazebo CERLAB Simulator ===== -->
    <group if="$(arg start_gazebo)">
        <include file="$(find uav_simulator)/launch/start_headless.launch">
            <arg name="gui" value="false"/>
            <arg name="world_name" value="$(arg tunnel_world)"/>
            <arg name="spawn_x" value="-8.5"/>
            <arg name="spawn_y" value="0.0"/>
            <arg name="spawn_z" value="0.1"/>
        </include>
    </group>

    <!-- ===== Bridge Adapter Layer ===== -->

    <!-- Fake MAVROS: services + state for IPC -->
    <node pkg="navigation_runner" type="mavros_fake_node.py"
          name="mavros_fake" output="screen"/>

    <!-- IMU Bridge: CERLAB odom/acc -> /mavros/imu/data -->
    <node pkg="navigation_runner" type="imu_bridge_node.py"
          name="imu_bridge" output="screen">
        <param name="rate" value="100"/>
    </node>

    <!-- IPC visualization uses the original "world" frame while the CERLAB
         simulator publishes odom/TF in "map". Bridge them with an identity TF. -->
    <node pkg="tf2_ros" type="static_transform_publisher"
          name="world_to_map_tf"
          args="0 0 0 0 0 0 world map"/>

    <!-- LiDAR Simulator: PCD -> PointCloud2 -->
    <node pkg="navigation_runner" type="lidar_sim_node.py"
          name="lidar_sim" output="screen">
        <param name="pcd_file" value="$(arg tunnel_map)"/>
        <param name="rate" value="10"/>
        <param name="max_range" value="50.0"/>
        <param name="noise_stddev" value="0.02"/>
        <param name="frame_id" value="world"/>
    </node>

    <!-- RC Simulator: automated mode switching + shared RL usermodel commands -->
    <node pkg="navigation_runner" type="rc_sim_node.py"
          name="rc_sim" output="screen">
        <!-- Keep the RC edge pulses short so the drone does not spend seconds
             moving in Hover/Pilot before the actual AutoPilot run begins. -->
        <param name="init_delay" value="0.1"/>
        <param name="switch_delay" value="0.15"/>
        <param name="autopilot_edge_delay" value="0.1"/>
        <param name="autopilot_rearm_delay" value="0.1"/>
        <param name="autopilot_latch_delay" value="0.3"/>
        <param name="use_user_model" value="true"/>
        <param name="device" value="$(arg device)"/>
        <param name="user_model_simple" value="$(arg user_model_simple)"/>
        <param name="user_model_profile" value="$(arg user_model_profile)"/>
        <param name="user_model_speed" value="$(arg user_model_speed)"/>
        <param name="user_model_freq_base" value="$(arg user_model_freq_base)"/>
        <param name="user_model_freq_scale" value="$(arg user_model_freq_scale)"/>
        <param name="user_model_vx_bias" value="$(arg user_model_vx_bias)"/>
        <param name="user_model_vx_amp" value="$(arg user_model_vx_amp)"/>
        <param name="user_model_vy_amp" value="$(arg user_model_vy_amp)"/>
        <param name="user_model_vz_amp" value="$(arg user_model_vz_amp)"/>
        <param name="user_model_smoothness_base" value="$(arg user_model_smoothness_base)"/>
        <param name="user_model_smoothness_scale" value="$(arg user_model_smoothness_scale)"/>
        <param name="user_model_laziness" value="$(arg user_model_laziness)"/>
        <param name="user_model_seed" value="$(arg user_model_seed)"/>
        <param name="user_model_rate" value="$(arg user_model_rate)"/>
        <param name="forward_stick" value="0.8"/>
        <param name="auto_takeoff" value="true"/>
        <param name="takeoff_wait" value="0.6"/>
    </node>

    <!-- Command Bridge: PositionCommand -> cmd_vel -->
    <node pkg="navigation_runner" type="cmd_bridge_node.py"
          name="cmd_bridge" output="screen">
        <param name="max_vel" value="3.0"/>
        <param name="yaw_gain" value="1.0"/>
    </node>

    <!-- ===== IPC Node (from slope_inspection) ===== -->
    <node pkg="ipc" type="ipc_node" name="ipc_node" output="screen"
          launch-prefix="$(arg ipc_launch_prefix)">
        <!-- Service remaps -->
        <remap from="reboot"    to="/mavros/cmd/command"/>
        <remap from="arming"    to="/mavros/cmd/arming"/>
        <remap from="set_mode"  to="/mavros/set_mode"/>

        <!-- Publish remaps -->
        <remap from="pvaj_cmd"   to="/planning/pos_cmd"/>
        <remap from="px4_cmd"    to="/mavros/setpoint_raw/attitude"/>
        <remap from="astar_path" to="/astar/path"/>
        <remap from="astar_map"  to="/astar/map"/>
        <remap from="mpc_path"   to="/ipc/path"/>
        <remap from="goal_pub"   to="/ipc/goal"/>
        <remap from="sfc"        to="/ipc/sfc"/>

        <!-- Subscribe remaps: bridge from CERLAB Gazebo -->
        <remap from="odom"     to="/CERLAB/quadcopter/odom_raw"/>
        <remap from="imu"      to="/mavros/imu/data"/>
        <remap from="imu_raw"  to="/mavros/imu/data_raw"/>
        <remap from="battery"  to="/mavros/battery"/>
        <remap from="goal"     to="/goal"/>
        <remap from="rc"       to="/mavros/rc/in"/>
        <remap from="state"    to="/mavros/state"/>
        <remap from="local_pc" to="/pcl_render_node/cloud"/>

        <rosparam command="load"
                  file="$(find navigation_runner)/cfg/tunnel/ipc_gazebo_param.yaml"/>
    </node>

    <!-- ===== Flight Recorder ===== -->
    <group if="$(arg record)">
        <node pkg="navigation_runner" type="flight_recorder.py"
              name="flight_recorder" output="screen"
              required="$(arg shutdown_on_complete)">
            <param name="method" value="ipc"/>
            <param name="trial_id" value="$(arg trial_id)"/>
            <param name="output_dir" value="$(arg output_dir)"/>
            <param name="rate" value="50"/>
            <param name="goal_x" value="$(arg goal_x)"/>
            <param name="collision_dist" value="$(arg collision_dist)"/>
            <param name="pcd_file" value="$(arg tunnel_map)"/>
            <param name="auto_terminate" value="$(arg auto_terminate)"/>
            <param name="shutdown_on_complete" value="$(arg shutdown_on_complete)"/>
            <param name="timeout_sec" value="$(arg timeout_sec)"/>
            <param name="completion_grace_period" value="$(arg completion_grace_period)"/>
            <param name="batch_idx" value="$(arg batch_idx)"/>
            <param name="run_idx" value="$(arg run_idx)"/>
            <param name="run_id" value="$(arg run_id)"/>
            <param name="map_seed" value="$(arg map_seed)"/>
            <param name="user_model_seed" value="$(arg user_model_seed)"/>
            <param name="user_model_profile" value="$(arg user_model_profile)"/>
            <param name="user_model_simple" value="$(arg user_model_simple)"/>
            <param name="user_model_speed" value="$(arg user_model_speed)"/>
            <param name="user_model_freq_base" value="$(arg user_model_freq_base)"/>
            <param name="user_model_freq_scale" value="$(arg user_model_freq_scale)"/>
            <param name="user_model_vx_bias" value="$(arg user_model_vx_bias)"/>
            <param name="user_model_vx_amp" value="$(arg user_model_vx_amp)"/>
            <param name="user_model_vy_amp" value="$(arg user_model_vy_amp)"/>
            <param name="user_model_vz_amp" value="$(arg user_model_vz_amp)"/>
            <param name="tunnel_world" value="$(arg tunnel_world)"/>
        </node>
    </group>

    <!-- ===== RViz ===== -->
    <group if="$(arg rviz)">
        <node pkg="rviz" type="rviz" name="rviz_ipc"
              args="-d $(find navigation_runner)/cfg/tunnel/ipc_tunnel.rviz"/>
    </group>
</launch>
