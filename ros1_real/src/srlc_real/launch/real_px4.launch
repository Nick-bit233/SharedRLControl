<launch>
    <arg name="checkpoint" default="$(optenv SRLC_CHECKPOINT /root/real_assets/ckpts/checkpoint_minrisk_0610.pt)"/>
    <arg name="pcd_file" default="$(optenv SRLC_PCD_FILE /root/real_assets/maps/room601/0624_section_resampled6w_ascii_aligned_yaw_m4p50_floor_level_z0.pcd)"/>
    <arg name="device" default="$(optenv SRLC_DEVICE cpu)"/>
    <arg name="rviz" default="$(optenv SRLC_RVIZ false)"/>
    <arg name="record" default="$(optenv SRLC_RECORD true)"/>
    <arg name="output_dir" default="$(optenv SRLC_OUTPUT_DIR /root/real_outputs)"/>
    <arg name="run_id" default="$(optenv SRLC_RUN_ID real_px4_nokov)"/>
    <arg name="start_stream_guard" default="$(optenv START_MAVLINK_STREAM_GUARD true)"/>

    <arg name="map_yaw_deg" default="$(optenv SRLC_MAP_YAW_DEG 0.0)"/>
    <arg name="map_origin_x" default="$(optenv SRLC_MAP_ORIGIN_X 0.0)"/>
    <arg name="map_origin_y" default="$(optenv SRLC_MAP_ORIGIN_Y 0.0)"/>
    <arg name="map_origin_z" default="$(optenv SRLC_MAP_ORIGIN_Z 0.0)"/>
    <arg name="vehicle_half_extents" default="$(optenv SRLC_VEHICLE_HALF_EXTENTS [0.15,0.15,0.05])"/>
    <arg name="policy_extra_margin" default="$(optenv SRLC_POLICY_EXTRA_MARGIN [0.05,0.05,0.0])"/>
    <arg name="clearance_cap" default="$(optenv SRLC_CLEARANCE_CAP 1.0)"/>

    <arg name="takeoff_height" default="$(optenv SRLC_TAKEOFF_HEIGHT 1.0)"/>
    <arg name="post_takeoff_mode" default="$(optenv SRLC_POST_TAKEOFF_MODE assist)"/>
    <arg name="takeoff_lower_margin" default="$(optenv SRLC_TAKEOFF_LOWER_MARGIN 0.2)"/>
    <arg name="takeoff_upper_margin" default="$(optenv SRLC_TAKEOFF_UPPER_MARGIN 0.2)"/>
    <arg name="takeoff_max_abs_vz" default="$(optenv SRLC_TAKEOFF_MAX_ABS_VZ 0.25)"/>
    <arg name="takeoff_confirm_duration" default="$(optenv SRLC_TAKEOFF_CONFIRM_DURATION 0.5)"/>
    <arg name="takeoff_timeout" default="$(optenv SRLC_TAKEOFF_TIMEOUT 15.0)"/>
    <arg name="takeoff_max_overshoot" default="$(optenv SRLC_TAKEOFF_MAX_OVERSHOOT 0.5)"/>
    <arg name="takeoff_max_xy_drift" default="$(optenv SRLC_TAKEOFF_MAX_XY_DRIFT 0.5)"/>
    <arg name="takeoff_max_climb_speed" default="$(optenv SRLC_TAKEOFF_MAX_CLIMB_SPEED 0.4)"/>
    <arg name="takeoff_max_vertical_accel" default="$(optenv SRLC_TAKEOFF_MAX_VERTICAL_ACCEL 0.5)"/>
    <arg name="takeoff_max_tracking_error" default="$(optenv SRLC_TAKEOFF_MAX_TRACKING_ERROR 0.25)"/>
    <arg name="input_recovery_grace" default="$(optenv SRLC_INPUT_RECOVERY_GRACE 1.0)"/>
    <arg name="fault_response" default="$(optenv SRLC_FAULT_RESPONSE hold)"/>
    <arg name="fault_land_mode" default="$(optenv SRLC_FAULT_LAND_MODE AUTO.LAND)"/>
    <arg name="fault_land_confirm_timeout" default="$(optenv SRLC_FAULT_LAND_CONFIRM_TIMEOUT 2.0)"/>
    <arg name="fault_land_retry_interval" default="$(optenv SRLC_FAULT_LAND_RETRY_INTERVAL 0.5)"/>
    <arg name="fault_land_max_attempts" default="$(optenv SRLC_FAULT_LAND_MAX_ATTEMPTS 3)"/>
    <arg name="lock_z_control" default="$(optenv SRLC_LOCK_Z_CONTROL true)"/>
    <arg name="require_offboard" default="$(optenv SRLC_REQUIRE_OFFBOARD true)"/>
    <arg name="real_auto_takeoff_on_offboard" default="$(optenv SRLC_AUTO_TAKEOFF true)"/>

    <arg name="forward_reverse" default="$(optenv SRLC_RC_FORWARD_REVERSE false)"/>
    <arg name="lateral_reverse" default="$(optenv SRLC_RC_LATERAL_REVERSE true)"/>
    <arg name="max_xy_speed_real" default="$(optenv SRLC_MAX_XY_SPEED 0.5)"/>
    <arg name="max_z_speed_real" default="$(optenv SRLC_MAX_Z_SPEED 0.3)"/>
    <arg name="enable_proximity_guard" default="$(optenv SRLC_ENABLE_PROXIMITY_GUARD false)"/>
    <arg name="proximity_enter_clearance" default="$(optenv SRLC_PROXIMITY_ENTER_CLEARANCE 0.10)"/>
    <arg name="proximity_release_clearance" default="$(optenv SRLC_PROXIMITY_RELEASE_CLEARANCE 0.15)"/>
    <arg name="proximity_release_duration" default="$(optenv SRLC_PROXIMITY_RELEASE_DURATION 0.20)"/>
    <arg name="proximity_escape_min_speed" default="$(optenv SRLC_PROXIMITY_ESCAPE_MIN_SPEED 0.05)"/>
    <arg name="collision_confirm_clearance" default="$(optenv SRLC_COLLISION_CONFIRM_CLEARANCE 0.02)"/>
    <arg name="collision_confirm_frames" default="$(optenv SRLC_COLLISION_CONFIRM_FRAMES 2)"/>
    <arg name="collision_immediate_clearance" default="$(optenv SRLC_COLLISION_IMMEDIATE_CLEARANCE -0.03)"/>
    <arg name="clearance_guard_mode" default="$(optenv SRLC_CLEARANCE_GUARD_MODE enforce)"/>
    <arg name="assist_input_deadzone_norm" default="$(optenv SRLC_ASSIST_INPUT_DEADZONE_NORM 0.05)"/>
    <arg name="geofence_x_min" default="$(optenv SRLC_GEOFENCE_X_MIN -3.0)"/>
    <arg name="geofence_x_max" default="$(optenv SRLC_GEOFENCE_X_MAX 3.0)"/>
    <arg name="geofence_y_min" default="$(optenv SRLC_GEOFENCE_Y_MIN -3.0)"/>
    <arg name="geofence_y_max" default="$(optenv SRLC_GEOFENCE_Y_MAX 3.0)"/>
    <arg name="min_altitude" default="$(optenv SRLC_MIN_ALTITUDE 0.5)"/>
    <arg name="max_altitude" default="$(optenv SRLC_MAX_ALTITUDE 3.0)"/>

    <arg name="odom_topic" default="/nokov/local_position/odom"/>
    <arg name="px4_local_odom_topic" default="$(optenv SRLC_PX4_LOCAL_ODOM_TOPIC /mavros/local_position/odom)"/>
    <arg name="px4_local_velocity_topic" default="$(optenv SRLC_PX4_LOCAL_VELOCITY_TOPIC /mavros/local_position/velocity_local)"/>
    <arg name="rc_topic" default="/mavros/rc/in"/>
    <arg name="setpoint_raw_topic" default="/mavros/setpoint_raw/local"/>
    <arg name="map_cloud_topic" default="/real_map/cloud"/>
    <arg name="map_cloud_voxel_size" default="0.1"/>
    <arg name="map_cloud_max_points" default="300000"/>

    <group if="$(arg start_stream_guard)">
        <include file="$(find srlc_real)/launch/mavlink_stream_guard.launch"/>
    </group>

    <node pkg="srlc_real" type="map_lidar_node.py"
          name="map_lidar_node" output="screen" required="true">
        <rosparam file="$(find srlc_real)/cfg/tunnel/map_lidar_real_px4.yaml"/>
        <param name="pcd_file" value="$(arg pcd_file)"/>
        <param name="odom_topic" value="$(arg odom_topic)"/>
        <param name="map_yaw_deg" value="$(arg map_yaw_deg)"/>
        <rosparam param="map_origin_xyz" subst_value="true">[$(arg map_origin_x), $(arg map_origin_y), $(arg map_origin_z)]</rosparam>
        <rosparam param="vehicle_half_extents" subst_value="true">$(arg vehicle_half_extents)</rosparam>
        <rosparam param="policy_extra_margin" subst_value="true">$(arg policy_extra_margin)</rosparam>
        <param name="clearance_cap" value="$(arg clearance_cap)"/>
    </node>

    <node pkg="srlc_real" type="pcd_map_publisher.py"
          name="real_map_publisher" output="screen">
        <param name="pcd_file" value="$(arg pcd_file)"/>
        <param name="frame_id" value="map"/>
        <param name="topic" value="$(arg map_cloud_topic)"/>
        <param name="voxel_size" value="$(arg map_cloud_voxel_size)"/>
        <param name="max_points" value="$(arg map_cloud_max_points)"/>
        <param name="publish_rate" value="0.2"/>
        <param name="latch" value="true"/>
    </node>

    <node pkg="srlc_real" type="srlc_alignment_viz_node.py"
          name="srlc_alignment_viz_node" output="screen">
        <param name="odom_topic" value="$(arg odom_topic)"/>
        <param name="map_yaw_deg" value="$(arg map_yaw_deg)"/>
        <rosparam param="map_origin_xyz" subst_value="true">[$(arg map_origin_x), $(arg map_origin_y), $(arg map_origin_z)]</rosparam>
        <rosparam param="geofence_x" subst_value="true">[$(arg geofence_x_min), $(arg geofence_x_max)]</rosparam>
        <rosparam param="geofence_y" subst_value="true">[$(arg geofence_y_min), $(arg geofence_y_max)]</rosparam>
        <param name="min_altitude" value="$(arg min_altitude)"/>
        <param name="max_altitude" value="$(arg max_altitude)"/>
    </node>

    <node pkg="srlc_real" type="rc_input_node.py"
          name="rc_input_node" output="screen" required="true">
        <rosparam file="$(find srlc_real)/cfg/tunnel/rc_input_real_px4.yaml"/>
        <param name="rc_topic" value="$(arg rc_topic)"/>
        <param name="forward_reverse" value="$(arg forward_reverse)"/>
        <param name="lateral_reverse" value="$(arg lateral_reverse)"/>
    </node>

    <node pkg="srlc_real" type="real_navigation_node.py"
          name="srlc_real_navigator" output="screen" required="true">
        <rosparam file="$(find srlc_real)/cfg/tunnel/real_nav_px4.yaml"/>
        <param name="checkpoint_path" value="$(arg checkpoint)"/>
        <param name="device" value="$(arg device)"/>
        <param name="odom_topic" value="$(arg odom_topic)"/>
        <param name="px4_local_odom_topic" value="$(arg px4_local_odom_topic)"/>
        <param name="px4_local_velocity_topic" value="$(arg px4_local_velocity_topic)"/>
        <param name="setpoint_raw_topic" value="$(arg setpoint_raw_topic)"/>
        <param name="takeoff_height" value="$(arg takeoff_height)"/>
        <param name="lock_z_control" value="$(arg lock_z_control)"/>
        <param name="require_offboard" value="$(arg require_offboard)"/>
        <param name="real_auto_takeoff_on_offboard" value="$(arg real_auto_takeoff_on_offboard)"/>
        <param name="post_takeoff_mode" value="$(arg post_takeoff_mode)"/>
        <param name="takeoff_lower_margin" value="$(arg takeoff_lower_margin)"/>
        <param name="takeoff_upper_margin" value="$(arg takeoff_upper_margin)"/>
        <param name="takeoff_max_abs_vz" value="$(arg takeoff_max_abs_vz)"/>
        <param name="takeoff_confirm_duration" value="$(arg takeoff_confirm_duration)"/>
        <param name="takeoff_timeout" value="$(arg takeoff_timeout)"/>
        <param name="takeoff_max_overshoot" value="$(arg takeoff_max_overshoot)"/>
        <param name="takeoff_max_xy_drift" value="$(arg takeoff_max_xy_drift)"/>
        <param name="takeoff_max_climb_speed" value="$(arg takeoff_max_climb_speed)"/>
        <param name="takeoff_max_vertical_accel" value="$(arg takeoff_max_vertical_accel)"/>
        <param name="takeoff_max_tracking_error" value="$(arg takeoff_max_tracking_error)"/>
        <param name="input_recovery_grace" value="$(arg input_recovery_grace)"/>
        <param name="fault_response" value="$(arg fault_response)"/>
        <param name="fault_land_mode" value="$(arg fault_land_mode)"/>
        <param name="fault_land_confirm_timeout" value="$(arg fault_land_confirm_timeout)"/>
        <param name="fault_land_retry_interval" value="$(arg fault_land_retry_interval)"/>
        <param name="fault_land_max_attempts" value="$(arg fault_land_max_attempts)"/>
        <param name="assist_input_deadzone_norm" value="$(arg assist_input_deadzone_norm)"/>
        <param name="max_xy_speed_real" value="$(arg max_xy_speed_real)"/>
        <param name="max_z_speed_real" value="$(arg max_z_speed_real)"/>
        <param name="enable_proximity_guard" value="$(arg enable_proximity_guard)"/>
        <param name="proximity_enter_clearance" value="$(arg proximity_enter_clearance)"/>
        <param name="proximity_release_clearance" value="$(arg proximity_release_clearance)"/>
        <param name="proximity_release_duration" value="$(arg proximity_release_duration)"/>
        <param name="proximity_escape_min_speed" value="$(arg proximity_escape_min_speed)"/>
        <param name="collision_confirm_clearance" value="$(arg collision_confirm_clearance)"/>
        <param name="collision_confirm_frames" value="$(arg collision_confirm_frames)"/>
        <param name="collision_immediate_clearance" value="$(arg collision_immediate_clearance)"/>
        <param name="clearance_guard_mode" value="$(arg clearance_guard_mode)"/>
        <param name="min_altitude" value="$(arg min_altitude)"/>
        <param name="max_altitude" value="$(arg max_altitude)"/>
        <rosparam param="geofence_x" subst_value="true">[$(arg geofence_x_min), $(arg geofence_x_max)]</rosparam>
        <rosparam param="geofence_y" subst_value="true">[$(arg geofence_y_min), $(arg geofence_y_max)]</rosparam>
    </node>

    <group if="$(arg record)">
        <node pkg="srlc_real" type="srlc_real_recorder.py"
              name="srlc_real_recorder" output="screen">
            <param name="output_dir" value="$(arg output_dir)"/>
            <param name="run_id" value="$(arg run_id)"/>
            <param name="odom_topic" value="$(arg odom_topic)"/>
            <param name="px4_local_odom_topic" value="$(arg px4_local_odom_topic)"/>
            <param name="px4_local_velocity_topic" value="$(arg px4_local_velocity_topic)"/>
            <param name="rc_topic" value="$(arg rc_topic)"/>
            <param name="setpoint_raw_topic" value="$(arg setpoint_raw_topic)"/>
            <param name="lidar_range" value="4.0"/>
            <param name="lidar_hbeams" value="36"/>
            <param name="lidar_vbeams" value="4"/>
        </node>
    </group>

    <group if="$(arg rviz)">
        <node pkg="rviz" type="rviz" name="srlc_real_rviz"
              args="-d $(find srlc_real)/cfg/real_map/real_map.rviz"/>
    </group>
</launch>
